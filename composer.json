{
    "name": "xpiston/monetico",
    "description": "Monetico Paiement (Cr\u00e9dit Mutuel / CIC) for PHP, Laravel and Symfony: sealed payment forms, verified notifications, capture and refund.",
    "keywords": [
        "monetico",
        "monetico-paiement",
        "payment",
        "cmcic",
        "credit-mutuel",
        "cic",
        "laravel",
        "symfony",
        "3dsecure"
    ],
    "homepage": "https://github.com/xPiston/monetico",
    "license": "MIT",
    "type": "library",
    "require": {
        "php": "^8.2",
        "ext-hash": "*",
        "ext-json": "*",
        "psr/http-client": "^1.0",
        "psr/http-factory": "^1.0",
        "psr/http-message": "^1.1 || ^2.0"
    },
    "require-dev": {
        "illuminate/support": "^12.0 || ^13.0",
        "laravel/pint": "^1.18",
        "nyholm/psr7": "^1.8",
        "orchestra/testbench": "^10.0",
        "php-http/discovery": "^1.19",
        "phpstan/phpstan": "^2.1",
        "phpunit/phpunit": "^11.5 || ^12.0",
        "symfony/config": "^6.4 || ^7.0",
        "symfony/dependency-injection": "^6.4 || ^7.0",
        "symfony/http-client": "^6.4 || ^7.0",
        "symfony/http-foundation": "^6.4 || ^7.0",
        "symfony/http-kernel": "^6.4 || ^7.0"
    },
    "suggest": {
        "php-http/discovery": "Finds the PSR-18 client and PSR-17 factories on its own, so capture and refund need no wiring.",
        "symfony/http-client": "A PSR-18 client for the capture and refund services.",
        "guzzlehttp/guzzle": "A PSR-18 client for the capture and refund services."
    },
    "autoload": {
        "psr-4": {
            "Piston\\Monetico\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Piston\\Monetico\\Tests\\": "tests/"
        }
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "php-http/discovery": true
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Piston\\Monetico\\Bridge\\Laravel\\MoneticoServiceProvider"
            ]
        }
    },
    "scripts": {
        "lint": "pint",
        "test:lint": "pint --test",
        "analyse": "phpstan analyse --memory-limit=512M",
        "test": "phpunit",
        "quality": [
            "@test:lint",
            "@analyse",
            "@test"
        ]
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
